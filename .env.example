# ------------------------
# Global project naming
# ------------------------
COMPOSE_PROJECT_NAME=shared-infra

# ------------------------
# Host ports
# ------------------------
MARIADB_PORT=3306
POSTGRES_PORT=5432
MONGODB_PORT=27017
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
KRAKEND_PORT=8088
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443
PORTAINER_EDGE_PORT=8000
REDISINSIGHT_PORT=5540
MONGO_EXPRESS_PORT=8081
PGADMIN_PORT=5050
CLOUDBEAVER_PORT=8978

# ------------------------
# MariaDB
# ------------------------
MARIADB_ROOT_PASSWORD=local_root_password
MARIADB_DATABASE=app_main
MARIADB_USER=app_user
MARIADB_PASSWORD=app_password

# ------------------------
# PostgreSQL
# ------------------------
POSTGRES_DB=app_main
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password

# If you must force a specific architecture image on Apple Silicon, set this:
# POSTGRES_PLATFORM=linux/amd64
POSTGRES_PLATFORM=

# ------------------------
# MongoDB
# ------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=local_root_password
MONGO_INITDB_DATABASE=app_main

# Optional app-level Mongo user created by init script
MONGO_APP_USERNAME=app_user
MONGO_APP_PASSWORD=app_password

# ------------------------
# Redis
# ------------------------
REDIS_PASSWORD=local_redis_password

# ------------------------
# RabbitMQ
# ------------------------
RABBITMQ_DEFAULT_USER=app_user
RABBITMQ_DEFAULT_PASS=app_password
RABBITMQ_DEFAULT_VHOST=/

# ------------------------
# Mongo Express (web UI for MongoDB)
# ------------------------
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=local_mongoexpress_password

# ------------------------
# pgAdmin (web UI for PostgreSQL)
# ------------------------
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=local_pgadmin_password

# ------------------------
# KrakenD
# ------------------------
# Point this to your gateway template folder.
# Use an absolute host path for reliability across shells/tools.
KRAKEND_CONFIG_DIR=/Users/<your-user>/Workspaces/templates/shared-infra-gateway

# If your template builds to dist/krakend.json, point to the dist directory:
# KRAKEND_CONFIG_DIR=/Users/<your-user>/Workspaces/templates/paycloud-apigateway/dist
# KRAKEND_CONFIG_DIR=/Users/<your-user>/Workspaces/templates/paycloud-apigatewayft/dist

# Host-native service that KrakenD forwards to in the sample config
HOST_SERVICE_BASE_URL=http://host.docker.internal:3000
